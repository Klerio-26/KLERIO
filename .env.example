# Copiez ce fichier vers .env et renseignez les valeurs.
# En local, démarrez PostgreSQL avec `docker compose up -d db`.

# PostgreSQL — pooled (Vercel Postgres / Neon) pour l'application
DATABASE_URL="postgresql://klerio:klerio_dev_password@localhost:5432/klerio"
# PostgreSQL — connexion directe (non poolée) pour les migrations Prisma
DIRECT_URL="postgresql://klerio:klerio_dev_password@localhost:5432/klerio"

APP_URL="http://localhost:3000"

# Secret de signature des sessions (openssl rand -base64 48)
SESSION_SECRET="changez-moi-en-production-svp-48-caracteres-minimum"

# Clé maître de chiffrement du coffre-fort : 32 octets en base64.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KLERIO_MASTER_KEY=""

# Protection du cron de rappels (Vercel Cron l'envoie automatiquement)
CRON_SECRET="changez-moi"

# Stockage objet compatible S3, région UE — OBLIGATOIRE SUR VERCEL.
# En local, laisser vide utilise STORAGE_DIR (système de fichiers).
S3_REGION="eu-west-3"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_ENDPOINT=""
S3_FORCE_PATH_STYLE="false"

# Dossier de stockage local uniquement (non persistant sur Vercel)
STORAGE_DIR="./storage"

# IA — sans clé, Klerio utilise un moteur local de démonstration (aucune donnée envoyée).
AI_PROVIDER="auto" # auto | mock | anthropic
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-5"

# Stripe — sans clé, la simulation locale est possible si DEV_ALLOW_SIMULATION=true.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_FAMILY_MONTHLY=""
STRIPE_PRICE_FAMILY_YEARLY=""

# Courriel transactionnel (console en dev)
EMAIL_PROVIDER="console"
EMAIL_FROM="Klerio <bonjour@klerio.fr>"

# Autorise les boutons de simulation (paiement, upgrade) hors Stripe.
# DOIT être false en production.
DEV_ALLOW_SIMULATION="true"

# Web Push : npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
